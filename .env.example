ANTHROPIC_API_KEY=
PORT=3000
DB_PATH=./data/finance.db

# Permanent SimpleFIN access URL, obtained by redeeming a one-time setup token
# from bridge.simplefin.org. Contains credentials as basic-auth userinfo —
# treat it as a password and never commit it.
SIMPLEFIN_ACCESS_URL=

# IANA timezone the household's transaction dates should be read in. SimpleFIN
# timestamps are moments, not dates, so an evening purchase lands on the wrong
# calendar day (and occasionally the wrong budget month) if this is wrong.
# Defaults to the system timezone, which is UTC inside the NAS container —
# so set it explicitly there.
TIMEZONE=America/Denver

# Shared-secret key the mobile app / any API client must send as the
# `x-api-key` header on every /api/* request. Required — the server refuses
# all /api requests if this is unset. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
